# Database (Supabase or any Postgres). Use the pooled connection string for serverless.
DATABASE_URL="postgresql://user:password@host:5432/morukai?schema=public"

# AI provider (Anthropic preferred). Either is fine.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="morukai-verify-token"

# PayTR
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_TEST_MODE="1"

# Admin
ADMIN_PASSWORD="change-me"

# Cron / scheduled message endpoint protection
CRON_SECRET="change-me"

# Public site URL (for PayTR callbacks, success URLs, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
